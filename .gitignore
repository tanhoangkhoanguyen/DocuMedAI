# Environment
**/.env
**/venv
**/.venv

# GCP service-account key (Vertex AI credentials - never commit)
gcp-sa.json
**/gcp-sa.json

# Cache
**/__pycache__
**/data_storage/
**/chroma
**/logs
/.pytest_cache

# Documents
**.pdf
**.json
**.jsonl

# Vector database benchmark results files
!/backend/VectorBench/sweep_results/**
!/backend/VectorBench/throughput_results/**
!/backend/VectorBench/upload_results/**

# Keep project manifests that tooling (npm, tsc) requires.
!**/package.json
!**/package-lock.json
!**/tsconfig.json

# Keep Go golden fixtures. These are hand-authored test inputs, not output —
# without this the **.json rule above drops them and CI fails on a missing file.
!/backend/llmguard/provider/vertex/testdata/**

# Provisioned Grafana dashboard -- config, not a result. The blanket **.json above
# is why this was never committed: the compose mount then created a 0-byte file
# where Grafana expected JSON.
!/backend/llmguard/observability/*.json