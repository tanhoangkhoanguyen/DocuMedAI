schema vector {
    document vector {
        field collection type string {
            indexing: attribute | summary
        }
        field query type string {
            indexing: summary
        }
        field embedded_query type tensor<float>(x[384]) {
            indexing: attribute
            attribute {
                distance-metric: angular
            }
        }
    }

    rank-profile default {
        inputs {
            query(query_embedding) tensor<float>(x[384])
        }
        first-phase {
            expression: closeness(field, embedded_query)
        }
    }
}