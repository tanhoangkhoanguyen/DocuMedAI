# Application
UUID_NAMESPACE="your-uuid-namespace"
INTERNAL_API_BASE=http://la-documedai:2010

# AI Providers
# Chat completions run on Google Vertex AI (ADC via a service-account key).
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_SA_KEY_PATH="./gcp-sa.json"    # host path to the service-account JSON (mounted read-only)

GEMINI_API_KEY="your-gemini-api-key"  # Optional
OPENAI_API_KEY="your-openai-api-key"  # Optional

SEED_FORCE=false # skip prod_dataset reupload

# LangSmith / LangChain (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langsmith-api-key"
LANGCHAIN_PROJECT="your-project-name"

# Authentication / Security
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
AUTH_JWT_SECRET="your-random-auth-secret"

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

HF_TOKEN="your-huggingface-READ-token" # For HuggingFace API access

# --- LLMGuard (backend/llmguard) -------------------------------------------
# The gateway reads .env directly (env_file), so ANY var here reaches it -- the
# ones below are just the ones worth naming. Defaults are in
# internal/gateway/config.go; unset means "use the default", not "disabled".

# The chatbot's summarisation call goes through LLMGuard. Both REQUIRED and
# non-empty: blank fails at startup rather than guessing.
LLM_GATEWAY_URL=http://la-llmguard:8081
LLM_GATEWAY_PROVIDER=vertex           # upstream name in llmguard/config.yaml

# Resilience knobs. RATE_LIMIT_RPM caps arrival RATE, MAX_IN_FLIGHT caps
# CONCURRENCY -- they bound different things and diverge when upstream slows.
# RATE_LIMIT_RPM=480                  # per-route limits in config.yaml win
# MAX_IN_FLIGHT=256                   # admission ceiling; over it sheds 429
# CIRCUIT_INTERVAL=60s                # window the failure ratio is measured over
# RETRY_MAX=4

# Tracing is OFF unless this is set; nothing is installed when it is empty.
# Needs the `observability` profile up.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://la-otel-collector:4318

# GEMINI_API_KEY (AI Providers block above) is also the credential for the
# commented openai-compat upstream in llmguard/config.yaml. Export it BEFORE
# uncommenting that entry -- an empty api_key_env is a startup error.

# --- Benchmark only (backend/llmguard/bench) -------------------------------
# Leave these unset for normal runs: MOCK_LATENCY makes the mock upstream slow
# on purpose, and a raised RATE_LIMIT_RPM disables the limiter that scenario A
# needs out of the way. See bench/README.md.
# LLMGUARD_REPLICAS=2                 # `multi-replica` profile
# MOCK_LATENCY=2000ms                 # stand-in for a real model's think time
# MOCK_ERROR_RATE=0.8                 # 0..1, injected failures (scenario D)
# MOCK_CHUNK_DELAY=120ms              # gap between SSE frames
# MOCK_COMPLETION_TOKENS=24
# NGINX_WORKER_CONNECTIONS=1024       # per worker; worker_processes is pinned to 1
